<?xml version="1.0" encoding="utf-8"?>
<!--
    Full backup (Android 11 and lower): exclude everything from backup.
    Nothing in the app is worth backing up: settings live on the earbuds.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
